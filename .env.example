# Copy to .env and set your key. Exported variables override the files.
# .env.local takes precedence over .env within each searched directory.
STEPFUN_API_KEY=

# global: api.stepfun.ai; china: api.stepfun.com. Keys are cluster-specific.
STEPFUN_CLUSTER=global

# Only required for room mode: python examples/voice_agent.py dev
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# zh, en; ja, ko, fr, es in preview. The service defaults to English.
STEPFUN_LANGUAGE=en

# Streaming and batch endpoints accept different model IDs.
STEPFUN_ASR_MODEL=stepaudio-2.5-asr-stream
STEPFUN_BATCH_ASR_MODEL=stepaudio-3-asr-max
# websocket or http; http waits for each utterance and has no interim transcripts.
STEPFUN_ASR_TRANSPORT=websocket

# --- Chat model -----------------------------------------------------------
# stepfun | deepseek. STT and TTS are always StepFun; only chat switches.
# Fixed per process: restart the session to compare models.
LLM_PROVIDER=stepfun

STEPFUN_LLM_MODEL=step-3.7-flash
# low, medium, high; only sent for models that document it (step-3.7-flash).
STEPFUN_REASONING_EFFORT=low

# Used when LLM_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

STEPFUN_TTS_MODEL=stepaudio-3-tts
# Use await tts.list_voices() to discover available voice IDs.
STEPFUN_TTS_VOICE=vibrant-youth

# Streaming interruptions; batch ASR always requires local VAD.
STEPFUN_LOCAL_VAD=true
STEPFUN_MIN_INTERRUPTION_DURATION=0.2
# off, webrtc, rnnoise. RNNoise requires the noise-cancellation extra.
STEPFUN_NOISE_CANCELLATION=off

# Optional dataset replay endpoint. Leave blank for normal microphone input.
STEPFUN_EVAL_PORT=
# Failed trials are recorded and the run continues; stop after this many in a row.
STEPFUN_EVAL_MAX_CONSECUTIVE_FAILURES=3
# Disable explicit connection prewarming for startup comparisons.
STEPFUN_PREWARM=true
STEPFUN_VAD_SILENCE_DURATION_MS=800

# Unrecoverable provider errors tolerated before the session closes. The SDK
# default is 3; this example keeps a wide margin so one dropped TTS websocket
# does not end the call.
STEPFUN_MAX_UNRECOVERABLE_ERRORS=25
