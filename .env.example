# Copy to .env and set your key. Exported variables override the files.
# .env.local takes precedence over .env within each searched directory.
STEPFUN_API_KEY=

# global: api.stepfun.ai; china: api.stepfun.com. Keys are cluster-specific.
STEPFUN_CLUSTER=global

# Only required for room mode: python examples/voice_agent.py dev
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# zh, en; ja, ko, fr, es in preview. The service defaults to English.
STEPFUN_LANGUAGE=en

# Streaming and batch endpoints accept different model IDs.
STEPFUN_ASR_MODEL=stepaudio-2.5-asr-stream
STEPFUN_BATCH_ASR_MODEL=stepaudio-3-asr-max
# websocket or http; http waits for each utterance and has no interim transcripts.
STEPFUN_ASR_TRANSPORT=websocket

# --- Chat model -----------------------------------------------------------
# stepfun | deepseek. STT and TTS are always StepFun; only chat switches.
# Fixed per process: restart the session to compare models.
LLM_PROVIDER=stepfun

STEPFUN_LLM_MODEL=step-3.7-flash
# low, medium, high, or none. Sent only for models that document it
# (step-5-preview, step-3.7-flash); none leaves the model's default alone.
STEPFUN_REASONING_EFFORT=low

# Used when LLM_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4.1-flash
# Override for a gateway, a proxy, or a privately hosted model. /v1 is
# appended when absent. StepFun's endpoint comes from STEPFUN_CLUSTER.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

STEPFUN_TTS_MODEL=stepaudio-3-tts
# Use await tts.list_voices() to discover available voice IDs.
STEPFUN_TTS_VOICE=vibrant-youth

# Streaming interruptions; batch ASR always requires local VAD.
STEPFUN_LOCAL_VAD=true
# Min length (s) of overlapping speech that counts as a barge-in. Raise in noise.
STEPFUN_MIN_INTERRUPTION_DURATION=0.5
# vad (provider-agnostic) or adaptive (LiveKit Inference ML classifier; needs creds).
STEPFUN_INTERRUPTION_MODE=vad
# Resume the reply if an interruption turns out to be noise (needs a pause-capable
# audio output: room/telephony; console sinks ignore it).
STEPFUN_RESUME_FALSE_INTERRUPTION=true
# Seconds of post-interruption silence before it is classified false; none disables.
STEPFUN_FALSE_INTERRUPTION_TIMEOUT=2.0
# off | webrtc | rnnoise. Filtering happens before audio reaches STT, VAD and
# turn detection. webrtc is built into the SDK and is the usual choice; rnnoise
# needs `uv sync --extra examples --extra noise-cancellation`.
STEPFUN_NOISE_CANCELLATION=off

# --- Local VAD tuning (Silero) --------------------------------------------
# Governs batch segmentation and interruptions. Raise the activation threshold
# (0.5 -> ~0.6-0.7) and min_speech in a noisy room so background noise stops
# holding a segment open (which stalls ASR) and stops false barge-in.
STEPFUN_VAD_ACTIVATION_THRESHOLD=0.5
STEPFUN_VAD_MIN_SPEECH_MS=50
# Batch endpointing silence (distinct from STEPFUN_VAD_SILENCE_DURATION_MS, the
# streaming server-VAD's). Lower = snappier but cuts off mid-thought pauses.
STEPFUN_VAD_MIN_SILENCE_MS=550
# Optional VAD hysteresis; leave blank for the model default.
# STEPFUN_VAD_DEACTIVATION_THRESHOLD=

# --- ASR rate / batch turn detection --------------------------------------
# Rate the ASR receives and the post-noise-cancellation downsample target.
# 16 kHz is the VAD/turn-detector/ASR standard and sufficient for speech; the
# 48 kHz input is resampled to it (noise cancellation stays at 48 kHz).
STEPFUN_STT_SAMPLE_RATE=16000
# Batch turn detection: vad = pure VAD + endpointing, no semantic EOT model
# (default); v1-mini = local model; v1 = LiveKit Inference cloud (needs
# LIVEKIT_API_KEY/SECRET, billed). Streaming mode always uses server-VAD ("stt").
STEPFUN_TURN_DETECTOR_VERSION=vad
# Endpointing delays (s). In vad mode min_delay is the effective end-of-turn cost;
# max_delay only binds when a semantic detector is active and does not confirm.
STEPFUN_ENDPOINTING_MIN_DELAY=0.0
STEPFUN_ENDPOINTING_MAX_DELAY=2.5

# Disable explicit connection prewarming for startup comparisons.
STEPFUN_PREWARM=true
STEPFUN_VAD_SILENCE_DURATION_MS=800

# Said when the caller connects. Set to `none` to wait for them to speak first.
AGENT_GREETING=Hi! How can I help you today?
