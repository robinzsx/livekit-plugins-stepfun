# StepFun plugin example configuration.
#
# Copy to .env (or .env.local, which takes precedence) and fill in. Both are
# gitignored; this template is not, so never put real keys here.
#
#   cp .env.example .env
#
# An exported environment variable always beats these files, so one-off
# overrides still work:
#
#   STEPFUN_LANGUAGE=zh .venv1x/bin/python examples/voice_agent.py console

# ---------------------------------------------------------------------------
# StepFun credentials  (required)
# ---------------------------------------------------------------------------

STEPFUN_API_KEY=

# international -> api.stepfun.ai (default) | domestic -> api.stepfun.com
# Keys are NOT interchangeable: a domestic key returns 401 internationally.
STEPFUN_CLUSTER=international

# ---------------------------------------------------------------------------
# LiveKit  (only needed for `voice_agent.py dev`, i.e. a browser client)
#
# `voice_agent.py console` needs none of these — it runs locally against your
# microphone with no LiveKit account and no server.
# ---------------------------------------------------------------------------

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# Leaving the language unset selects English server-side, on both ASR and TTS.
# It is not inferred from the cluster, so set zh explicitly for Chinese.
# zh | en | ja | ko | fr | es   (the last four are preview)
STEPFUN_LANGUAGE=en

# Streaming ASR. The bidirectional endpoint accepts stepaudio-2.5-asr-stream
# only — stepaudio-3-asr-stream is rejected with "unsupported model".
STEPFUN_ASR_MODEL=stepaudio-2.5-asr-stream

# Batch ASR, used by recognize() and whenever STEPFUN_ASR_TRANSPORT=http.
# This is the only way to use StepAudio 3 for recognition, and it returns a
# noticeably cleaner transcript than the streaming model.
STEPFUN_BATCH_ASR_MODEL=stepaudio-3-asr-max

# websocket (default) | http
#
# http runs the batch model behind a VAD-driven StreamAdapter: more accurate,
# but no interim transcripts and an extra request round trip per utterance.
STEPFUN_ASR_TRANSPORT=websocket

# Keep local VAD for faster interruptions in streaming mode; StepFun still
# owns end-of-turn detection. Set false to use transcripts for interruptions.
# Batch mode always enables local VAD and the local v1-mini audio turn detector.
STEPFUN_LOCAL_VAD=true

# Speech required before stopping a reply, in seconds (0.05 to 5).
# Lower is more responsive but more sensitive to short sounds; SDK default is 0.5.
STEPFUN_MIN_INTERRUPTION_DURATION=0.2

# off (default) | webrtc | rnnoise. Local CPU suppression before STT/VAD/turns.
# webrtc uses the installed LiveKit SDK; rnnoise requires the optional extra:
# uv sync --extra examples --extra noise-cancellation
STEPFUN_NOISE_CANCELLATION=off

# step-3.7-flash (default) | step-5-preview | step-3.5-flash
#
# step-5-preview is a 1M-context reasoning model built for agentic work; its
# thinking lands before the agent can start speaking, so treat it as a
# quality-over-latency choice for voice.
STEPFUN_LLM_MODEL=step-3.7-flash

# low | medium | high — documented for step-3.7-flash. Lower means less
# silence before the reply starts.
STEPFUN_REASONING_EFFORT=low

# Voice ID. An unknown one is rejected with 400 voice_id_invalid; list the
# valid ones with `await tts.list_voices()`. The international catalogue has 7
# voices and is a strict subset of the domestic 39.
STEPFUN_TTS_VOICE=vibrant-youth
